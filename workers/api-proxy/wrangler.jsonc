{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gonggu-api-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-07-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api.gongguwish.com",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  // Confirm namespace IDs are unused in this Cloudflare account before release.
  "ratelimits": [{
    "name": "TODAY_CALENDAR_RATE_LIMITER",
    "namespace_id": "2026101501",
    "simple": { "limit": 300, "period": 60 },
  }],
  // TODAY_CALENDAR_ANON_KEY is a Worker secret, never a source-controlled var.
  "vars": {
    "APP_ENV": "production",
    "SUPABASE_ORIGIN": "https://iosdoheblabfimkjnvfj.supabase.co",
    "ALLOWED_ORIGINS": "https://gongguwish.com,https://www.gongguwish.com",
  },
}
