@@ -0,0 +1,34 @@
+package io.invertase.googlemobileads;
+
+import android.content.Context;
+import android.content.ContextWrapper;
+import android.content.res.Configuration;
+import android.util.DisplayMetrics;
+
+/** Keeps the missing 4x AdChoices asset out of Google Ads requests at high density. */
+public final class ReactNativeGoogleMobileAdsRequestContext {
+  private ReactNativeGoogleMobileAdsRequestContext() {}
+
+  public static Context create(Context context) {
+    Context applicationContext = context.getApplicationContext();
+    if (applicationContext == null
+        || applicationContext.getResources().getDisplayMetrics().densityDpi
+            < DisplayMetrics.DENSITY_XXXHIGH) {
+      return context;
+    }
+
+    // https://github.com/googleads/googleads-mobile-android-examples/issues/1055
+    // A resource override is local to this SDK context; app and device settings stay intact.
+    Configuration override = new Configuration();
+    override.densityDpi = DisplayMetrics.DENSITY_XXXHIGH - 1;
+    Context densityContext = applicationContext.createConfigurationContext(override);
+    return new ContextWrapper(densityContext) {
+      @Override
+      public Context getApplicationContext() {
+        // GMA normalizes and caches the application context during initialize().
+        // Preserve the override through that normalization and subsequent native requests.
+        return this;
+      }
+    };
+  }
+}
