{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "env": {
        "APP_VARIANT": "preview",
        "GOOGLE_SERVICES_REQUIRED": "true",
        "EXPO_PUBLIC_ADMOB_MODE": "test",
        "EXPO_PUBLIC_ADMOB_REQUESTS_ENABLED": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-development": {
      "extends": "preview",
      "developmentClient": true
    },
    "production": {
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "GOOGLE_SERVICES_REQUIRED": "true",
        "EXPO_PUBLIC_ADMOB_MODE": "production",
        "EXPO_PUBLIC_ADMOB_REQUESTS_ENABLED": "false"
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production-ads-qa-apk": {
      "extends": "production-apk",
      "channel": "production-ads-qa",
      "env": {
        "APP_VARIANT": "production",
        "GOOGLE_SERVICES_REQUIRED": "true",
        "EXPO_PUBLIC_ADMOB_MODE": "production",
        "EXPO_PUBLIC_ADMOB_REQUESTS_ENABLED": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
