# Expo's `preview` variable bucket stores the Preview credentials.
# Pull them with `npx eas env:pull --environment preview`.
# Never commit the resulting .env.local file or a real Firebase service file.
APP_VARIANT=preview
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-preview-supabase-anon-key
EXPO_PUBLIC_SUPABASE_URL=https://your-preview-project.supabase.co
EXPO_PUBLIC_API_PROXY_URL=https://api-preview.gongguwish.com
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://gongguwish.com/privacy
EXPO_PUBLIC_TERMS_OF_SERVICE_URL=https://gongguwish.com/terms
EXPO_PUBLIC_ADMOB_MODE=test
EXPO_PUBLIC_ADMOB_REQUESTS_ENABLED=true
# Production values come from the EAS `production` environment. Never guess IDs.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-0000000000000000~0000000000
EXPO_PUBLIC_ADMOB_HOME_NATIVE_UNIT_ID=ca-app-pub-0000000000000000/0000000000
EXPO_PUBLIC_ADMOB_REELS_NATIVE_UNIT_ID=ca-app-pub-0000000000000000/0000000000
EXPO_PUBLIC_ADMOB_DETAIL_NATIVE_UNIT_ID=ca-app-pub-0000000000000000/0000000000
GOOGLE_SERVICES_JSON=./google-services.preview.json
